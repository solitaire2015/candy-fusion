{
  "name": "candy-fusion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "npm run typecheck && vite build && npm run build:wechat",
    "build:web": "vite build",
    "build:wechat": "node scripts/build-wechat.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": { "matter-js": "0.20.0" },
  "devDependencies": {
    "@types/matter-js": "^0.20.2",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "minigame-api-typings": "^3.8.12",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
